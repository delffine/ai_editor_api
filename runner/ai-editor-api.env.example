# Секреты API-версии ИИ-редактора. Скопировать в ~/.config/ai-editor-api.env и chmod 600.
# run.sh загружает этот файл в окружение прогона; в модели ключи не попадают
# (у моделей нет доступа к shell и файлам — только наши инструменты).

# PlusVibeAPI (provider:plusvibe, основной с 07.11.2026): ключ из личного кабинета plusvibeapi.ru
PLUSVIBE_API_KEY=

# ИИ-шлюз Beget (панель Beget -> ИИ-шлюз -> ключи). Можно завести отдельные ключи по этапам
# (свой месячный лимит и белый список моделей) и указать их имена в config.ini (key_env этапа).
BEGET_API_KEY=

# ИИ-шлюз Рег.облака (кабинет Рег.облака -> ИИ-платформа -> API-ключи), provider:regru
REGRU_API_KEY=

# Yandex AI Studio (модели, provider:yandex): API-ключ сервисного аккаунта с ролью ai.languageModels.user
# (область yc.ai.foundationModels.execute). Каталог — YANDEX_FOLDER_ID ниже (тот же, что у поиска)
YANDEX_AI_API_KEY=

# Yandex Search API v2: API-ключ сервисного аккаунта с ролью search-api.webSearch.user и id каталога
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# VK API (wall.get) для social.py — можно тот же, что у syzran-news
VK_ACCESS_TOKEN=

# Лента сборщика, если в config.ini [run] feed пусто (URL или путь к файлу)
AI_EDITOR_FEED_URL=
